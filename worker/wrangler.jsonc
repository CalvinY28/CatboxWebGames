{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catbox-game-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "multiplayer.catbox.party",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
